{
  "manifest_version": 3,
  "key": "",
  "name": "小红书运营工具箱",
  "version": "2.44.2",
  "description": "小红书运营必备：抓取/分析/改写/生成 + 创作者中心数据中心，100%本地DOM读取，不爬虫不封号",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "clipboardWrite",
    "activeTab",
    "sidePanel",
    "tabs",
    "alarms",
    "cookies"
  ],
  "host_permissions": [
    "https://*.xiaohongshu.com/*",
    "https://*.xhs.cn/*",
    "https://edith.xiaohongshu.com/*",
    "https://api.minimaxi.com/*",
    "https://api.minimax.chat/*",
    "https://api.openai.com/*",
    "https://api.moonshot.cn/*",
    "https://api.deepseek.com/*",
    "https://api.siliconflow.cn/*",
    "https://api.bigmodel.cn/*",
    "https://open.bigmodel.cn/*",
    "https://dashscope.aliyuncs.com/*",
    "http://127.0.0.1:8123/*",
    "http://127.0.0.1:8645/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "open-sidepanel": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "打开小红书运营工具箱侧边栏"
    }
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_title": "打开小红书运营工具箱"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.xiaohongshu.com/*",
        "https://*.xhs.cn/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.xiaohongshu.com/*",
        "https://*.xhs.cn/*"
      ],
      "js": [
        "net-listener.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
